# SwiftPM build products and local state. `.build` matches at any depth, so a
# nested package's build directory is covered too.
.build/
.swiftpm/
*.doccarchive

# Xcode, for anyone who opens the package there rather than building it.
DerivedData/
*.xcodeproj/
*.xcworkspace/

# The tooling under Scripts/ and scripts/ is Python.
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

.DS_Store

# Agent work plans.
/docs/superpowers/
/plans/
/superpowers/

# Variables for a program run by hand, such as the socket of its own that keeps
# it off your tmux. CONTRIBUTING.md says how to use one.
.env
